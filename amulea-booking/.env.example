####################################################################
# Amulea 予約システム 環境変数の見本
####################################################################
#
# 【このファイルについて】
#   これは「見本」です。ここに本物のパスワードや鍵を書かないでください。
#   このファイルは Git に登録されており、誰でも見られます。
#
# 【実際に使うとき】
#   1. このファイルをコピーして .env.local という名前にします
#        cp .env.example .env.local
#   2. .env.local の中身を、本物の値に書き換えます
#   3. .env.local は Git に登録されません（.gitignore で除外済み）
#
# 【Vercel に公開するとき】
#   .env.local はアップロードしません。
#   Vercel の画面「Settings → Environment Variables」に
#   1つずつ登録してください。手順は README.md にあります。
#
####################################################################


####################################################################
# 【1】動作モード
####################################################################

# 開発中は true にしておきます。
#   true  … Google も LINE も使わず、サーバーのメモリ上だけで動きます。
#           予約〜変更〜キャンセルまで全部そのまま試せます。
#           （サーバーを再起動するとデータは消えます）
#   false … Google カレンダー・スプレッドシート・LINE と連携します。
#
# ★ 本番公開時は必ず false にしてください。
MOCK_MODE=true

# このアプリの公開URL。
# ローカル開発中は http://localhost:3000 のままで大丈夫です。
# 公開後は https://booking.amulea.jp のように書き換えます。
APP_URL=http://localhost:3000


####################################################################
# 【2】セッション（ログイン状態）の署名鍵  ※必須
####################################################################

# ログイン状態が偽造されないようにするための、長いランダム文字列です。
#
# 作り方（ターミナルで実行）:
#     node scripts/generate-secret.mjs
#
# ★ 絶対に他人へ教えないでください。
# ★ この値を変更すると、全員がログアウトされます。
SESSION_SECRET=


####################################################################
# 【3】管理者ログイン
####################################################################

# 管理画面（/admin）へログインするための ID です。
ADMIN_ID=admin

# パスワードは「ハッシュ」にして保存します。
#
# 作り方（ターミナルで実行）:
#     node scripts/hash-password.mjs "設定したいパスワード"
#
# 表示された1行をそのまま貼り付けてください。
# 形式: scrypt$<英数字>$<英数字>
ADMIN_PASSWORD_HASH=

# MOCK_MODE=true かつ ADMIN_PASSWORD_HASH が空のときだけ使える、
# 開発用の簡易パスワードです。本番では使われません。
ADMIN_DEV_PASSWORD=amulea-dev


####################################################################
# 【4】Google 連携（カレンダー・スプレッドシート）
####################################################################
# 取得手順は docs/SETUP-GOOGLE.md に、画面つきで書いてあります。

# サービスアカウントのメールアドレス
# 例: amulea-booking@amulea-booking-123456.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=

# サービスアカウントの秘密鍵。
# ダウンロードした JSON ファイルの "private_key" の値をそのまま貼ります。
# ★ 前後のダブルクォート（"）ごと貼り付けてください。
# ★ 改行が \n という2文字になっていますが、そのままで正しいです。
GOOGLE_PRIVATE_KEY=""

# 予約を書き込む Google カレンダーの ID。
# ご自身のカレンダーならメールアドレスがそのまま ID になります。
GOOGLE_CALENDAR_ID=amulea.163@gmail.com

# 予約データを保存する Google スプレッドシートの ID。
# スプレッドシートのURLの、/d/ と /edit のあいだの文字列です。
# 例: https://docs.google.com/spreadsheets/d/【ここがID】/edit
GOOGLE_SPREADSHEET_ID=

# シート（タブ）の名前。変更しなくて構いません。
GOOGLE_SHEET_NAME=reservations
GOOGLE_SETTINGS_SHEET_NAME=settings


####################################################################
# 【5】LINE 連携
####################################################################
# 取得手順は docs/SETUP-LINE.md に、画面つきで書いてあります。

# LIFF ID（お客様の画面で使うため、これだけはブラウザにも渡されます）
# 例: 1234567890-abcdefgh
NEXT_PUBLIC_LIFF_ID=

# LINE ログインチャネルの「チャネルID」（数字のみ）
# IDトークンの検証に使います。
LINE_LOGIN_CHANNEL_ID=

# Messaging API チャネルの「チャネルアクセストークン（長期）」
# ★ これが漏れると、誰でもサロンの名前でLINEを送れてしまいます。
# ★ 絶対に公開しないでください。
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# 通知を受け取る管理者の LINE userId。
# カンマ区切りで複数指定できます。
# 取得方法は docs/SETUP-LINE.md の「手順6」を参照してください。
# 例: U1234567890abcdef1234567890abcdef
LINE_ADMIN_USER_IDS=


####################################################################
# 【6】レート制限（変更不要）
####################################################################

# 同じ人が windowSec 秒間に何回まで書き込み操作できるか
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=60
